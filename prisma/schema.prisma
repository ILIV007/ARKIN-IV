// ARKIN IV — Prisma schema.
// SQLite keeps the global leaderboard fallback for local development.
// In production (Cloudflare Workers) scores live in the ARKIN_KV namespace —
// see src/lib/scores/store.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Score {
  id         String   @id @default(cuid())
  gameId     String // snake | muncher | blockfall | pong
  name       String   @default("AAA") // 3-letter arcade initials
  score      Int
  difficulty String   @default("normal")
  createdAt  DateTime @default(now())

  @@index([gameId, score])
  @@index([gameId, createdAt])
}
